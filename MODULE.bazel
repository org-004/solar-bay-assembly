"""Solar bay assembly cell: simulation, perception, planning, control."""

module(
    name = "solar_bay_assembly",
    version = "0.0.0",
)

# Rules for building C++ (cc_binary, cc_library, cc_test).
bazel_dep(name = "rules_cc", version = "0.2.28")

# Physics engine. Its C API is the target @mujoco//:mujoco.
bazel_dep(name = "mujoco", version = "4.0.0")

# Vectors and matrices. MuJoCo already depends on this version, so naming it
# here adds nothing to the download.
bazel_dep(name = "eigen", version = "5.0.1.bcr.2")

# Window and OpenGL context for the viewer.
bazel_dep(name = "glfw", version = "3.4.0.bcr.4")

# JSON for the layouts of the cell (layouts/*.json, src/layout.h).
bazel_dep(name = "nlohmann_json", version = "3.12.0.bcr.2")

# Test framework. Only this repository's tests need it.
bazel_dep(name = "googletest", version = "1.18.0.bcr.1", dev_dependency = True)

