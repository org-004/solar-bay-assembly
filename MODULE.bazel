"""Solar module pick-and-place cell: simulation, perception, planning, control."""

module(
    name = "solar_panel_pick_place",
    version = "0.0.0",
)

# Rules for building C++ (cc_binary, cc_library, cc_test).
bazel_dep(name = "rules_cc", version = "0.2.28")

# Physics engine. Its C API is the target @mujoco//:mujoco.
bazel_dep(name = "mujoco", version = "4.0.0")

# Window and OpenGL context for the viewer.
bazel_dep(name = "glfw", version = "3.4.0.bcr.4")

# Test framework. Only this repository's tests need it.
bazel_dep(name = "googletest", version = "1.18.0.bcr.1", dev_dependency = True)

# The stand-in arm until the KUKA model exists: Universal Robots UR10e from
# MuJoCo Menagerie, downloaded file by file at a pinned commit. Not a Bazel
# module, so it comes through a repository rule defined in this repository.
# To self-host, copy the files elsewhere and set base_url.
menagerie_model = use_repo_rule("//bazel:menagerie.bzl", "menagerie_model")

