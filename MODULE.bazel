# OMPL, the Open Motion Planning Library. The planner can search with it in
# place of its own RRT-Connect (src/ompl_search.h, chosen at run time by
# MotionPlanOptions::search), so every target that plans compiles and links
# it, and `bazel build //...` fetches and builds it. OMPL is not in the Bazel
# Central Registry and has no Bazel files of its own; bazel/ompl.BUILD.bazel
# is this repository's build file for it. The archive is the one OMPL's
# maintainers upload with each release (it has the git submodules inside,
# which GitHub's own archive of the tag lacks), and the hash is the one they
# publish beside it. To self-host, copy the archive elsewhere and put that
# address first in `urls`.
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "ompl",
    build_file = "//bazel:ompl.BUILD.bazel",
    sha256 = "b9155e243e555b04b01f8e4ff7e21a48582edbab9c300a611289655778bcd29d",
    strip_prefix = "ompl-2.0.2",
    urls = ["https://github.com/ompl/ompl/releases/download/2.0.2/ompl-2.0.2.tar.gz"],
)

# The Boost libraries whose headers OMPL's core includes by name. Each is its
# own module in the registry and pulls in the Boost libraries it needs in
# turn. Only boost.serialization has anything to compile; the rest are
# headers.
