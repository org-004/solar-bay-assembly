<!--
  The container in its working state, alone, for tests/container_test.cc
  and for looking at.

    bazel run //:viewer_container

  The container stands at the world's origin. No bay is in this scene: the
  container's envelopes bind the stowed cell only, and where a bay is built
  is a layout's choice (bazel run //:viewer_bay draws the bay).
-->
<mujoco model="container scene">
  <include file="common.xml"/>
  <include file="container.xml"/>
</mujoco>
