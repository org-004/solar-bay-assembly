<!--
  The suction tool: a standoff bolted to the arm's flange, carrying a flat
  plate with eight cups on its far side.

  This file is included inside the body it is mounted on, so its frame is
  that body's frame: the origin is at the centre of the flange face and +Z
  points out of the flange. The plate's long side runs along X, to lie along
  a module's long side.

  The site tool_tip is where the cups meet the glass: at the centre of the
  cup plane, 0.30 m out along +Z, with +Z pointing out of the tool toward the
  module. To grip, tool_tip is brought onto the glass with its Z axis
  pointing into the glass.

  Along Z: the standoff runs from 0 to 0.24, the plate from 0.24 to 0.26 and
  the cups from 0.26 to 0.30. The plate is 1.2 m x 0.6 m, so it sits well
  inside a 2.3 m x 1.1 m module face. 25 kg in all: standoff 6, plate 15,
  cups 0.5 each.

  MuJoCo has no suction. The grip is a weld constraint that src/suction.h
  switches on and points at a module (see models/suction.xml). The cups are
  ordinary rubber-like geoms: they touch the glass, with high friction, but
  hold nothing by themselves.

  Every geom states contype, conaffinity and condim itself, so that a
  childclass on the body this file is included in cannot switch the tool's
  collisions off or change them.
-->
<mujocoinclude>
  <body name="tool">
    <geom name="tool_standoff" type="cylinder" size="0.06 0.12" pos="0 0 0.12"
          mass="6" contype="1" conaffinity="1" condim="3" rgba="0.3 0.3 0.3 1"/>
    <geom name="tool_plate" type="box" size="0.6 0.3 0.01" pos="0 0 0.25"
          mass="15" contype="1" conaffinity="1" condim="3" rgba="0.9 0.6 0.1 1"/>

    <!-- Four cups along X, two along Y. Their faces are at Z = 0.30, the
         plane of tool_tip. Friction 1: rubber on glass. -->
    <geom name="tool_cup_0" type="cylinder" size="0.04 0.02" pos="-0.45 -0.18 0.28"
          mass="0.5" contype="1" conaffinity="1" condim="3"
          friction="1 0.005 0.0001" rgba="0.1 0.1 0.1 1"/>
    <geom name="tool_cup_1" type="cylinder" size="0.04 0.02" pos="-0.15 -0.18 0.28"
          mass="0.5" contype="1" conaffinity="1" condim="3"
          friction="1 0.005 0.0001" rgba="0.1 0.1 0.1 1"/>
    <geom name="tool_cup_2" type="cylinder" size="0.04 0.02" pos="0.15 -0.18 0.28"
          mass="0.5" contype="1" conaffinity="1" condim="3"
          friction="1 0.005 0.0001" rgba="0.1 0.1 0.1 1"/>
    <geom name="tool_cup_3" type="cylinder" size="0.04 0.02" pos="0.45 -0.18 0.28"
          mass="0.5" contype="1" conaffinity="1" condim="3"
          friction="1 0.005 0.0001" rgba="0.1 0.1 0.1 1"/>
    <geom name="tool_cup_4" type="cylinder" size="0.04 0.02" pos="-0.45 0.18 0.28"
          mass="0.5" contype="1" conaffinity="1" condim="3"
          friction="1 0.005 0.0001" rgba="0.1 0.1 0.1 1"/>
    <geom name="tool_cup_5" type="cylinder" size="0.04 0.02" pos="-0.15 0.18 0.28"
          mass="0.5" contype="1" conaffinity="1" condim="3"
          friction="1 0.005 0.0001" rgba="0.1 0.1 0.1 1"/>
    <geom name="tool_cup_6" type="cylinder" size="0.04 0.02" pos="0.15 0.18 0.28"
          mass="0.5" contype="1" conaffinity="1" condim="3"
          friction="1 0.005 0.0001" rgba="0.1 0.1 0.1 1"/>
    <geom name="tool_cup_7" type="cylinder" size="0.04 0.02" pos="0.45 0.18 0.28"
          mass="0.5" contype="1" conaffinity="1" condim="3"
          friction="1 0.005 0.0001" rgba="0.1 0.1 0.1 1"/>

    <site name="tool_tip" pos="0 0 0.30" quat="1 0 0 0" size="0.02" rgba="1 0 0 1"/>
  </body>
</mujocoinclude>
