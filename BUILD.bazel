    data = CELL_FILES,
    env = {"MODEL_PATH": "$(rootpath %s)" % CELL_SCENE},
    deps = [
        ":arm",
        ":arm_follower",
        ":cell",
        ":collision",
        ":conveyor",
        ":cycle_check",
        ":joint_move",
        ":motion_planner",
        ":path_timing",
        ":pick_place",
        ":rrt",
        "@eigen",
        "@googletest//:gtest_main",
        "@mujoco",
    ],
)

