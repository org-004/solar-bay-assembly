# BEGIN suction
# The suction tool and its test bench. A scene with the tool includes
# tool.xml inside the body it is mounted on, and suction.xml (the weld that
# stands in for suction) at the top level.
SUCTION_SCENE = "models/suction_scene.xml"

SUCTION_SCENE_FILES = MODELS_COMMON + [
    SUCTION_SCENE,
    "models/suction.xml",
    "models/tool.xml",
]

# Gripping and releasing a module with the weld.
# Include as "src/suction.h".
cc_library(
    name = "suction",
    srcs = ["src/suction.cc"],
    hdrs = ["src/suction.h"],
    deps = [
        "@eigen",
        "@mujoco",
    ],
)

# Grips that must fail, grips that must pick the right module, a held module
# keeping its pose through a full carry, and clean releases. Simulates about
# three minutes on the test bench, in a few seconds.
#   bazel test //:suction_test
cc_test(
    name = "suction_test",
    size = "small",
    srcs = ["tests/suction_test.cc"],
    data = SUCTION_SCENE_FILES,
    env = {"MODEL_PATH": "$(rootpath %s)" % SUCTION_SCENE},
    deps = [
        ":joint_move",
        ":mj_handles",
        ":suction",
        "@eigen",
        "@googletest//:gtest_main",
        "@mujoco",
    ],
)

# Draws the suction test bench in a window.
#   bazel run //:viewer_suction
cc_binary(
    name = "viewer_suction",
    srcs = ["src/viewer.cc"],
    args = ["$(rootpath %s)" % SUCTION_SCENE],
    data = SUCTION_SCENE_FILES,
    deps = [
        ":mj_handles",
        ":viewer_lib",
        "@mujoco",
    ],
)
# END suction

# Where the arm's joints, motors and tool are in a loaded model, and its
# limits. Include as "src/arm.h".
cc_library(
    name = "arm",
    srcs = ["src/arm.cc"],
    hdrs = ["src/arm.h"],
    deps = [
        ":joint_move",
        "@eigen",
        "@mujoco",
    ],
)

# BEGIN follower
# Drives the arm's motors along planned joint moves.
# Include as "src/arm_follower.h".
cc_library(
    name = "arm_follower",
    srcs = ["src/arm_follower.cc"],
    hdrs = ["src/arm_follower.h"],
    deps = [
        ":arm",
        ":joint_move",
        "@eigen",
        "@mujoco",
    ],
)

# The arm following planned moves in models/arm_scene.xml, with and without
# a module's weight at the tool; and FindArm and TipPose from src/arm.h.
# About a minute of simulated motion, 5 s in the default build. Add
# --test_output=all to see the measured numbers.
#   bazel test //:arm_follower_test
cc_test(
    name = "arm_follower_test",
    size = "small",
    srcs = ["tests/arm_follower_test.cc"],
    data = ARM_SCENE_FILES,
    env = {"MODEL_PATH": "$(rootpath %s)" % ARM_SCENE},
    deps = [
        ":arm",
        ":arm_follower",
        ":joint_move",
        ":mj_handles",
        "@eigen",
        "@googletest//:gtest_main",
        "@mujoco",
    ],
