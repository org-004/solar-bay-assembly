# (src/path_timing.h) sound. Include as "src/motion_planner.h".
cc_library(
    name = "motion_planner",
    srcs = ["src/motion_planner.cc"],
    hdrs = ["src/motion_planner.h"],
    deps = [
        ":arm",
        ":collision",
        ":joint_move",
        ":path_timing",
        ":rrt",
        "@eigen",
        "@mujoco",
    ],
)

# The cell's real carry (modules 0, 15 and 29, the tube empty and nearly
# full) and return, planned and re-checked finely at the required margin;
# determinism; statistics over 50 base seeds against the scripted path; the
# rounded trajectory checked densely; and one planned carry executed in the
# simulated cell under cycle_check. Run it optimized for the timings:
#   bazel test //:motion_planner_test
#   bazel test --config=opt //:motion_planner_test --test_output=all
cc_test(
