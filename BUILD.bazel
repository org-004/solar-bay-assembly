load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

# The arm used until the KUKA model exists: MuJoCo Menagerie's UR10e, fetched
# as the external repository @menagerie_ur10e (declared in MODULE.bazel).
# ur10e.xml refers to the mesh files in assets/ by relative path, so the
# meshes have to travel with it.
UR10E = "@menagerie_ur10e//:ur10e.xml"

# Listing UR10E by itself as well lets $(rootpath ...) below name that one file.
UR10E_FILES = [
    UR10E,
    "@menagerie_ur10e//:ur10e",
]

# Owning handles for mjModel and mjData, shared by everything below.
# Include as "src/mj_handles.h".
cc_library(
    name = "mj_handles",
    hdrs = ["src/mj_handles.h"],
    deps = ["@mujoco"],
)

# Loads a model, steps it for one simulated second, prints the joint angles.
#   bazel run //:step_arm
# $(rootpath ...) becomes the model's path relative to the directory the
# program is started in, and is passed as its first argument.
cc_binary(
    name = "step_arm",
    srcs = ["src/step_arm.cc"],
    args = ["$(rootpath %s)" % UR10E],
    data = UR10E_FILES,
    deps = [
        ":mj_handles",
        "@mujoco",
    ],
)

# Same load and step, with assertions.
#   bazel test //...
# The test reads the model's path from the MODEL_PATH environment variable.
cc_test(
    name = "step_test",
    size = "small",
    srcs = ["tests/step_test.cc"],
    data = UR10E_FILES,
    env = {"MODEL_PATH": "$(rootpath %s)" % UR10E},
    deps = [
        ":mj_handles",
        "@googletest//:gtest_main",
        "@mujoco",
    ],
)

# Velocity profiles for one axis: trapezoid and S-curve.
# Include as "src/profile.h".
cc_library(
    name = "profile",
    srcs = ["src/profile.cc"],
    hdrs = ["src/profile.h"],
)

cc_test(
    name = "profile_test",
    size = "small",
    srcs = ["tests/profile_test.cc"],
    deps = [
        ":profile",
        "@googletest//:gtest_main",
    ],
)

# A move of all joints together, timed by one profile.
# Include as "src/joint_move.h".
cc_library(
    name = "joint_move",
    srcs = ["src/joint_move.cc"],
    hdrs = ["src/joint_move.h"],
    deps = [
        ":profile",
        "@eigen",
    ],
)

cc_test(
    name = "joint_move_test",
    size = "small",
    srcs = ["tests/joint_move_test.cc"],
    deps = [
        ":joint_move",
        "@eigen",
        "@googletest//:gtest_main",
    ],
)

# Prints a trapezoid and an S-curve for the same move as CSV, or with
# --pretty as an aligned table.
#   bazel run //:print_profile
#   bazel run //:print_profile -- --pretty
cc_binary(
    name = "print_profile",
    srcs = ["src/print_profile.cc"],
    deps = [":profile"],
)

# Least-squares and RANSAC plane fits.
# Include as "src/plane_fit.h".
cc_library(
    name = "plane_fit",
    srcs = ["src/plane_fit.cc"],
    hdrs = ["src/plane_fit.h"],
    deps = ["@eigen"],
)

# Made-up point clouds with known answers, for testing the plane fit.
# Include as "src/point_generator.h".
cc_library(
    name = "point_generator",
    srcs = ["src/point_generator.cc"],
    hdrs = ["src/point_generator.h"],
    deps = [
        ":plane_fit",
        "@eigen",
    ],
)

cc_test(
    name = "plane_fit_test",
    size = "small",
    srcs = ["tests/plane_fit_test.cc"],
    deps = [
        ":plane_fit",
        ":point_generator",
        "@eigen",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "point_generator_test",
    size = "small",
    srcs = ["tests/point_generator_test.cc"],
    deps = [
        ":plane_fit",
        ":point_generator",
        "@eigen",
        "@googletest//:gtest_main",
    ],
)

# Fits a plane to made-up pallet views and prints the error of each as CSV,
# or with --pretty as an aligned table.
#   bazel run //:print_plane_fit
#   bazel run //:print_plane_fit -- --pretty
cc_binary(
    name = "print_plane_fit",
    srcs = ["src/print_plane_fit.cc"],
    deps = [
        ":plane_fit",
        ":point_generator",
        "@eigen",
    ],
)

# Prints one made-up pallet view as CSV, one row per point, for plotting.
#   bazel run //:print_points
#   bazel run //:print_points -- <seed>
cc_binary(
    name = "print_points",
    srcs = ["src/print_points.cc"],
    deps = [
        ":plane_fit",
        ":point_generator",
        "@eigen",
    ],
)

# ---------------------------------------------------------------- the cell
# Model files live in models/. A scene includes common.xml and then its parts.
MODELS_COMMON = ["models/common.xml"]

# BEGIN arm
# The KUKA KR 210 R2700-2. models/arm.xml is ours; its meshes come from
# @kuka_kr210_r2700_2 (declared in MODULE.bazel). MuJoCo looks for mesh files
# relative to the top-level scene file, so the meshes are copied to
# models/kuka_kr210_r2700_2/, where arm.xml names them. In the runfiles tree
# they then sit next to every scene in models/.
ARM_MESH_FILES = [
    "%s/%s.stl" % (kind, link)
    for kind in ["visual", "collision"]
    for link in ["base_link", "link_1", "link_2", "link_3", "link_4", "link_5", "link_6"]
] + ["LICENSE"]

genrule(
    name = "arm_meshes",
    srcs = ["@kuka_kr210_r2700_2//:%s" % f for f in ARM_MESH_FILES],
    outs = ["models/kuka_kr210_r2700_2/%s" % f for f in ARM_MESH_FILES],
    cmd = "\n".join([
        "cp $(location @kuka_kr210_r2700_2//:{f}) $(location models/kuka_kr210_r2700_2/{f})".format(f = f)
        for f in ARM_MESH_FILES
    ]),
)

# Everything a scene needs to include arm.xml: the arm, the tool on its
# flange, and the meshes. A scene adds MODELS_COMMON and itself.
filegroup(
    name = "arm_model",
    srcs = [
        "models/arm.xml",
        "models/tool.xml",
        ":arm_meshes",
    ],
)

ARM_SCENE = "models/arm_scene.xml"

ARM_SCENE_FILES = MODELS_COMMON + [
    ARM_SCENE,
    ":arm_model",
]

# The arm alone: names, vendor numbers, holding a pose, the flange's place.
#   bazel test //:arm_test
cc_test(
    name = "arm_test",
    size = "small",
    srcs = ["tests/arm_test.cc"],
    data = ARM_SCENE_FILES,
    env = {"MODEL_PATH": "$(rootpath %s)" % ARM_SCENE},
    deps = [
        ":mj_handles",
        "@googletest//:gtest_main",
        "@mujoco",
    ],
)

# Draws the arm alone in a window. It starts at the keyframe arm_home.
#   bazel run //:viewer_arm
cc_binary(
    name = "viewer_arm",
    srcs = ["src/viewer.cc"],
    args = ["$(rootpath %s)" % ARM_SCENE],
    data = ARM_SCENE_FILES,
    deps = [
        ":mj_handles",
        ":viewer_lib",
        "@mujoco",
    ],
)
# END arm

# BEGIN pallet
# The pallet with its stack of 30 modules, in a scene of its own.
PALLET_SCENE = "models/pallet_scene.xml"

PALLET_SCENE_FILES = MODELS_COMMON + [
    "models/pallet.xml",
    PALLET_SCENE,
]

# Finds the pallet and the modules in a loaded scene, moves the pallet with
# its stack for each trial, and reads back where everything is.
# Include as "src/pallet.h".
cc_library(
    name = "pallet",
    srcs = ["src/pallet.cc"],
    hdrs = ["src/pallet.h"],
    deps = [
        "@eigen",
        "@mujoco",
    ],
)

# The stack stands still when left alone, still does when the pallet is
# moved, and the front module can be pulled off without dragging the next.
# Simulates about a minute of stack in all, which takes about 30 s in the
# default unoptimized build: medium, so a busy machine does not hit the 60 s
# limit of small.
cc_test(
    name = "pallet_test",
    size = "medium",
    srcs = ["tests/pallet_test.cc"],
    data = PALLET_SCENE_FILES,
    env = {"MODEL_PATH": "$(rootpath %s)" % PALLET_SCENE},
    deps = [
        ":mj_handles",
        ":pallet",
        "@eigen",
        "@googletest//:gtest_main",
        "@mujoco",
    ],
)

# Leaves the stack alone and prints how far each module moves, and how fast
# the scene simulates. Time it optimized:
#   bazel run --config=opt //:print_pallet
#   bazel run --config=opt //:print_pallet -- <seconds> <x> <y> <yaw>
cc_binary(
    name = "print_pallet",
    srcs = ["src/print_pallet.cc"],
    args = ["$(rootpath %s)" % PALLET_SCENE],
    data = PALLET_SCENE_FILES,
    deps = [
        ":mj_handles",
        ":pallet",
        "@eigen",
        "@mujoco",
    ],
)

# Draws the pallet scene in a window.
#   bazel run //:viewer_pallet
cc_binary(
    name = "viewer_pallet",
    srcs = ["src/viewer.cc"],
    args = ["$(rootpath %s)" % PALLET_SCENE],
    data = PALLET_SCENE_FILES,
    deps = [
        ":mj_handles",
        ":viewer_lib",
        "@mujoco",
    ],
)
# END pallet

