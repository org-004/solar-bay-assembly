CONVEYOR_SCENE = "models/conveyor_scene.xml"

CONVEYOR_SCENE_FILES = MODELS_COMMON + [
    "models/conveyor.xml",
    CONVEYOR_SCENE,
]

# Moves the tube on by one step and says where it is.
# Include as "src/conveyor.h".
cc_library(
    name = "conveyor",
    srcs = ["src/conveyor.cc"],
    hdrs = ["src/conveyor.h"],
    deps = [
        ":profile",
        "@eigen",
        "@mujoco",
    ],
)

#   bazel test //:conveyor_test
cc_test(
    name = "conveyor_test",
    # Medium: the tests simulate about 30 steps in all, some 120 s of
    # simulated time.
    size = "medium",
    srcs = ["tests/conveyor_test.cc"],
    data = CONVEYOR_SCENE_FILES,
    env = {"MODEL_PATH": "$(rootpath %s)" % CONVEYOR_SCENE},
    deps = [
        ":conveyor",
        ":mj_handles",
        "@eigen",
        "@googletest//:gtest_main",
        "@mujoco",
    ],
)

# Draws the conveyor scene in a window. Nothing drives the conveyor here, so
# the tube holds still.
#   bazel run //:viewer_conveyor
cc_binary(
    name = "viewer_conveyor",
    srcs = ["src/viewer.cc"],
    args = ["$(rootpath %s)" % CONVEYOR_SCENE],
    data = CONVEYOR_SCENE_FILES,
    deps = [
        ":mj_handles",
        ":viewer_lib",
        "@mujoco",
    ],
)
