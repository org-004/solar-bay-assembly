# BEGIN ik
# Inverse kinematics: joint angles that put the tool tip at a wanted pose,
# by damped least squares on MuJoCo's Jacobians; also the tip pose that
# grips a face (GripPose) and straight lines of poses (StraightLine).
# Include as "src/ik.h".
cc_library(
    name = "ik",
    srcs = ["src/ik.cc"],
    hdrs = ["src/ik.h"],
    deps = [
        ":arm",
        "@eigen",
        "@mujoco",
    ],
)

# The arm with a free-floating box defined before it, so that the arm's
# joints are not the first in the model.
IK_SCENE = "models/ik_scene.xml"

# Round trips, far seeds, the cell's own poses, every module picked (grip,
# lift, 0.4 m pull-back) across the pallet's placement tolerance, unreachable
# and singular targets, straight-line paths, the pose helpers, and the box
# scene. The cell layout is at the top of the test file. Prints accuracy,
# success rate, the cell poses' angles and margins, and the time per solve;
# time it optimized:
#   bazel test --config=opt //:ik_test --test_output=all
cc_test(
    name = "ik_test",
    size = "small",
    srcs = ["tests/ik_test.cc"],
    data = ARM_SCENE_FILES + [IK_SCENE],
    env = {
        "MODEL_PATH": "$(rootpath %s)" % ARM_SCENE,
        "IK_SCENE_PATH": "$(rootpath %s)" % IK_SCENE,
    },
    deps = [
        ":arm",
        ":ik",
        ":mj_handles",
        "@eigen",
        "@googletest//:gtest_main",
        "@mujoco",
    ],
)
# END ik

# BEGIN cell
# The whole cell in one scene: arm and tool, pallet and stack, conveyor and
# tube, the suction weld, and the depth camera on its post.
CELL_SCENE = "models/cell.xml"

# Everything a target needs to load models/cell.xml.
CELL_FILES = MODELS_COMMON + [
    CELL_SCENE,
    "models/pallet.xml",
    "models/conveyor.xml",
    "models/suction.xml",
    ":arm_model",
]

# Loads the cell, finds its parts, and sets up a scene for each trial; holds
# the bookkeeping of which module is where. Include as "src/cell.h".
cc_library(
    name = "cell",
    srcs = ["src/cell.cc"],
    hdrs = ["src/cell.h"],
    deps = [
        ":arm",
        ":camera_model",
        ":conveyor",
        ":mj_handles",
        ":pallet",
        ":suction",
        "@eigen",
        "@mujoco",
    ],
)

# Scores a run from the truth: placement errors on the tube, and how much
# the stack was disturbed. Include as "src/score.h".
cc_library(
    name = "score",
    srcs = ["src/score.cc"],
    hdrs = ["src/score.h"],
    deps = [
        ":cell",
        "@eigen",
    ],
)

# The parts together: names and counts, the stack still at rest with
# everything present, repeatable scenes, the camera's view, no stray
# contacts, the scorer, parking and swapping the tube. Simulates about 30 s
# of the whole cell, which takes about 20 s in the default unoptimized
# build: medium, like pallet_test, so a busy machine does not hit the 60 s
# limit of small.
#   bazel test //:cell_test
cc_test(
    name = "cell_test",
    size = "medium",
    srcs = ["tests/cell_test.cc"],
    # The arm's scene too, to check that loading a scene without a pallet
    # says so.
    data = CELL_FILES + [ARM_SCENE],
    env = {
        "MODEL_PATH": "$(rootpath %s)" % CELL_SCENE,
        "ARM_SCENE_PATH": "$(rootpath %s)" % ARM_SCENE,
    },
    deps = [
        ":arm",
        ":cell",
        ":conveyor",
        ":pallet",
        ":score",
        "@eigen",
        "@googletest//:gtest_main",
        "@mujoco",
    ],
)

# Loads and resets the cell, prints what touches what, where everything is,
# and how fast it simulates. Time it optimized:
#   bazel run --config=opt //:print_cell
#   bazel run --config=opt //:print_cell -- <seed> <seconds>
cc_binary(
    name = "print_cell",
    srcs = ["src/print_cell.cc"],
    args = ["$(rootpath %s)" % CELL_SCENE],
    data = CELL_FILES,
    deps = [
        ":arm",
        ":cell",
        ":pallet",
        ":score",
        "@eigen",
        "@mujoco",
    ],
)

# Draws the whole cell in a window, starting with the arm at arm_home.
# Nothing drives the arm or the conveyor here, so both hold still.
#   bazel run //:viewer_cell
cc_binary(
    name = "viewer_cell",
    srcs = ["src/viewer.cc"],
    args = ["$(rootpath %s)" % CELL_SCENE],
    data = CELL_FILES,
    deps = [
        ":mj_handles",
        ":viewer_lib",
        "@mujoco",
    ],
)
# END cell

# The window, mouse, keys and real-time loop shared by every viewer below and
# by programs that drive a simulation in a window. Include as
# "src/viewer_lib.h".
cc_library(
    name = "viewer_lib",
    srcs = ["src/viewer_lib.cc"],
    hdrs = ["src/viewer_lib.h"],
    deps = [
        ":mj_handles",
        "@glfw",
        "@mujoco",
    ],
)

# Draws the arm in a window.
#   bazel run //:viewer
cc_binary(
    name = "viewer",
    srcs = ["src/viewer.cc"],
    args = ["$(rootpath %s)" % UR10E],
    data = UR10E_FILES,
    deps = [
        ":mj_handles",
        ":viewer_lib",
        "@mujoco",
    ],
)

# BEGIN pick_place
# The blind pick and place: one module from the front of the stack onto the
# tube, as a state machine run one physics step at a time. Plans from the
# design poses only and never reads the truth.
# Include as "src/pick_place.h".
cc_library(
    name = "pick_place",
    srcs = ["src/pick_place.cc"],
    hdrs = ["src/pick_place.h"],
    deps = [
        ":arm",
        ":arm_follower",
        ":cell",
        ":conveyor",
        ":ik",
        ":mj_handles",
        ":pallet",
        ":suction",
        "@eigen",
        "@mujoco",
    ],
)

# Watches a cycle from the truth: forbidden contacts, closest approaches,
# motor torques, joint ranges. For tests and the runner only.
# Include as "src/cycle_check.h".
cc_library(
    name = "cycle_check",
    srcs = ["src/cycle_check.cc"],
    hdrs = ["src/cycle_check.h"],
    deps = [
        ":arm",
        ":cell",
        ":pick_place",
        "@eigen",
        "@mujoco",
    ],
)

# Runs the pick and place headless and prints the score of every cycle as
# CSV, or with --pretty as an aligned table. Time it optimized:
#   bazel run --config=opt //:run_cell -- --pretty --trials 10
#   bazel run //:run_cell -- [--pretty] [--seed N] [--modules M] [--trials T]
#                            [--nominal] [--verbose]
cc_binary(
    name = "run_cell",
    srcs = ["src/run_cell.cc"],
    args = ["$(rootpath %s)" % CELL_SCENE],
    data = CELL_FILES,
    deps = [
        ":cell",
        ":cycle_check",
        ":pick_place",
        ":score",
        "@mujoco",
    ],
)

# The same pick and place in a window, with the score of each placement in
# the corner. Backspace runs the trial again.
#   bazel run //:view_cell -- [--seed N] [--nominal] [--modules M]
cc_binary(
    name = "view_cell",
    srcs = ["src/view_cell.cc"],
    args = ["$(rootpath %s)" % CELL_SCENE],
    data = CELL_FILES,
    deps = [
        ":cell",
        ":pick_place",
        ":score",
        ":viewer_lib",
        "@mujoco",
    ],
)

# Each phase of the nominal cycle against its own postcondition, the whole
# cycle end to end, two modules in a row, the script's blindness, the place
# side from a constructed state, and a few randomized pallets. Simulates
# the nominal cycle once for the whole suite (about 70 s of the cell in
# all), which takes about 70 s in the default unoptimized build and 13 s
# optimized: medium, so a busy machine does not hit the limit.
#   bazel test //:pick_place_test
#   bazel test --config=opt //:pick_place_test --test_output=all
cc_test(
    name = "pick_place_test",
    size = "medium",
    srcs = ["tests/pick_place_test.cc"],
    data = CELL_FILES,
    env = {"MODEL_PATH": "$(rootpath %s)" % CELL_SCENE},
    deps = [
        ":arm",
        ":cell",
        ":conveyor",
        ":cycle_check",
        ":pallet",
        ":pick_place",
        ":score",
        ":suction",
        "@eigen",
        "@googletest//:gtest_main",
        "@mujoco",
    ],
)
# END pick_place

# ---------------------------------------------------------- perception
# BEGIN depth_camera
# A camera as a pinhole: projecting world points into the image, the ray
# through a pixel, a camera read from a MuJoCo model, and a calibration
# error. Include as "src/camera_model.h".
cc_library(
    name = "camera_model",
    srcs = ["src/camera_model.cc"],
    hdrs = ["src/camera_model.h"],
    deps = [
        "@eigen",
        "@mujoco",
    ],
)

# The depth image, by casting a ray through every pixel; a model of a real
# camera's errors; and the image back to 3D points.
# Include as "src/depth_camera.h".
cc_library(
    name = "depth_camera",
    srcs = ["src/depth_camera.cc"],
    hdrs = ["src/depth_camera.h"],
    deps = [
        ":camera_model",
        ":plane_fit",
        "@eigen",
        "@mujoco",
    ],
)

# The pinhole's round trip, the image against the true geometry of the
# cell, the noise model's statistics, calibration errors and misses. Renders
# the full 640 x 480 image a handful of times. Prints the time per image;
# time it optimized:
#   bazel test //:depth_camera_test
#   bazel test --config=opt //:depth_camera_test --test_output=all
cc_test(
    name = "depth_camera_test",
    size = "medium",
    srcs = ["tests/depth_camera_test.cc"],
    data = CELL_FILES,
    env = {"MODEL_PATH": "$(rootpath %s)" % CELL_SCENE},
    deps = [
        ":camera_model",
        ":cell",
        ":depth_camera",
        ":mj_handles",
        ":pallet",
        ":plane_fit",
        "@eigen",
        "@googletest//:gtest_main",
        "@mujoco",
    ],
)

# Resets the cell, puts the arm at arm_clear, takes a depth image and prints
# its statistics, writes it as a PGM, or prints its points as CSV.
#   bazel run //:print_depth -- [--seed N] [--nominal] [--noise]
#                               [--pgm FILE] [--pgm8 FILE] [--points]
cc_binary(
    name = "print_depth",
    srcs = ["src/print_depth.cc"],
    args = ["$(rootpath %s)" % CELL_SCENE],
    data = CELL_FILES,
    deps = [
        ":camera_model",
        ":cell",
        ":depth_camera",
        "@eigen",
        "@mujoco",
    ],
)
# END depth_camera

# BEGIN rectangle_fit
# The module's rectangle in the flattened dots of its face: strays dropped,
# convex hull and smallest-area rectangle as a first guess, then a line
# fitted to each side, and a check against the known size.
# Include as "src/rectangle_fit.h".
cc_library(
    name = "rectangle_fit",
    srcs = ["src/rectangle_fit.cc"],
    hdrs = ["src/rectangle_fit.h"],
    deps = ["@eigen"],
)

# Hull and smallest rectangle on hand-checked inputs; the whole fit on
# made-up pixel grids at every rotation, with ragged edges, missing and
# flying edge dots, strays and bites; refusals. Prints the accuracy of the
# first guess and of the refined fit. Add --test_output=all to see it.
#   bazel test //:rectangle_fit_test
cc_test(
    name = "rectangle_fit_test",
    size = "small",
    srcs = ["tests/rectangle_fit_test.cc"],
    deps = [
        ":rectangle_fit",
        "@eigen",
        "@googletest//:gtest_main",
    ],
)
# END rectangle_fit

# BEGIN module_finder
# The front module's pose from one depth image: points in the arm's frame,
# crop from the design, the glass's plane, its outline, a clear-view check
# and the pose. Include as "src/module_finder.h".
cc_library(
    name = "module_finder",
    srcs = ["src/module_finder.cc"],
    hdrs = ["src/module_finder.h"],
    deps = [
        ":camera_model",
        ":depth_camera",
        ":pallet",
        ":plane_fit",
        ":rectangle_fit",
        "@eigen",
    ],
)

# Each step alone (prior, crop, glass plane, flattening, pose), then the
# whole estimate against the truth over 3 pallets x 4 stack depths: exact,
# with the camera's noise, and with a calibration error, which must pass
# straight through; the refusals (arm in the way, no module left, wrong size,
# wrong lean, bad input); determinism. Renders 15 images and settles the cell
# for each: about 80 s in the default unoptimized build (a fit takes about
# 1 s there, 14 ms optimized), 6 s optimized. Large: on a machine busy with
# other builds the unoptimized run has come close to medium's 300 s.
#   bazel test //:module_finder_test
#   bazel test --config=opt //:module_finder_test --test_output=all
cc_test(
    name = "module_finder_test",
    size = "large",
    srcs = ["tests/module_finder_test.cc"],
    data = CELL_FILES,
    env = {"MODEL_PATH": "$(rootpath %s)" % CELL_SCENE},
    deps = [
        ":camera_model",
        ":cell",
        ":depth_camera",
        ":module_finder",
        ":pallet",
        ":plane_fit",
        ":rectangle_fit",
        "@eigen",
        "@googletest//:gtest_main",
        "@mujoco",
    ],
)

# The stage's table: estimated front-module pose against the truth over
# randomized pallets and stack depths. Run it optimized:
#   bazel run --config=opt //:print_perception -- --pretty
#   bazel run --config=opt //:print_perception -- --pretty --noise
#       --calibration-error 1,0.05 --trials 20 --depths 0,10,20,29
cc_binary(
    name = "print_perception",
    srcs = ["src/print_perception.cc"],
    args = ["$(rootpath %s)" % CELL_SCENE],
    data = CELL_FILES,
    deps = [
        ":camera_model",
        ":cell",
        ":depth_camera",
        ":module_finder",
        "@eigen",
        "@mujoco",
    ],
)
# END module_finder

# ------------------------------------------------------------ planning
# BEGIN collision
# Is the arm, with its tool and the module it carries, clear of everything
# at given joint angles? MuJoCo's collision detection on a private copy of
# the model with margins set, and its own scratch state; also straight
# joint-space segments and the step to check them at.
# Include as "src/collision.h".
cc_library(
    name = "collision",
    srcs = ["src/collision.cc"],
    hdrs = ["src/collision.h"],
    deps = [
        ":arm",
        ":mj_handles",
        ":pallet",
        "@eigen",
        "@mujoco",
    ],
)

# Free poses, poses that collide naming the right pair, the scripted
# cycle's own waypoints and the simulated cycle against cycle_check,
# margins, segments, the fast private model against a plain one, and
# obstacle updates. Prints the clearances along the scripted cycle and the
# time per query. About 50 s in the default unoptimized build (a simulated
# cycle and some 16,000 queries comparing the two models), 10 s optimized:
# medium. Time it optimized:
#   bazel test --config=opt //:collision_test --test_output=all
cc_test(
    name = "collision_test",
    size = "medium",
    srcs = ["tests/collision_test.cc"],
    data = CELL_FILES,
    env = {"MODEL_PATH": "$(rootpath %s)" % CELL_SCENE},
    deps = [
        ":arm",
        ":cell",
        ":collision",
        ":cycle_check",
        ":ik",
        ":mj_handles",
        ":pallet",
        ":pick_place",
        "@eigen",
        "@googletest//:gtest_main",
        "@mujoco",
    ],
)
# END collision

# BEGIN rrt
# RRT-Connect in joint space, path shortening, and path helpers, against an
# abstract collision check. Include as "src/rrt.h".
cc_library(
    name = "rrt",
    srcs = ["src/rrt.cc"],
    hdrs = ["src/rrt.h"],
    deps = ["@eigen"],
)

# Made-up worlds with known answers for the planner: 2D points among circles
# and boxes, and a 6-joint box shaped like the cell. Include as
# "src/rrt_worlds.h".
cc_library(
    name = "rrt_worlds",
    srcs = ["src/rrt_worlds.cc"],
    hdrs = ["src/rrt_worlds.h"],
    deps = [
        ":rrt",
        "@eigen",
    ],
)

# Paths found and free in the 2D worlds, failures reported with the right
# reason, the 6-joint world over 100 seeds, shortening, determinism, and the
# edge check order. Add --test_output=all to see the measured numbers; time
# them optimized:
#   bazel test //:rrt_test
#   bazel test --config=opt //:rrt_test --test_output=all
cc_test(
    name = "rrt_test",
    size = "small",
    srcs = ["tests/rrt_test.cc"],
    deps = [
        ":rrt",
        ":rrt_worlds",
        "@eigen",
        "@googletest//:gtest_main",
    ],
)

# One plan in a 2D world as CSV for plotting (obstacles, both trees, raw and
# shortened paths), or statistics over seeds. Time it optimized:
#   bazel run //:print_rrt -- [<world>] [<seed>]
