    ],
)

# The gate: kGateTrials whole pallets (src/trial_runner.h, docs/gate.md)
# with the camera, noise, the planned carry, the check after pickup and
# both calibrations off, failing on any placement out of tolerance. Each
# shard runs two whole pallets, about 4 minutes; the four shards together
# about 4 minutes on 4 cores. Failure files land in each shard's
# outputs.zip under bazel-testlogs/gate_test/; by hand, in a directory:
#   bazel test --config=opt //:gate_test --test_output=all
#   bazel run --config=opt --test_sharding_strategy=disabled //:gate_test \
#       -- --save-failures /tmp/gate
cc_test(
    name = "gate_test",
    size = "large",
    srcs = ["tests/gate_test.cc"],
    data = CELL_FILES,
    env = {"MODEL_PATH": "$(rootpath %s)" % CELL_SCENE},
    shard_count = 4,
    tags = ["gate"],
    deps = [
        ":trial_runner",
        "@googletest//:gtest",
    ],
)

# The gate by hand, a larger batch on threads, failures saved for replay:
#   bazel run --config=opt //:run_gate -- --trials 40 --save-failures /tmp/f
#   bazel run --config=opt //:run_cell -- --pretty --replay /tmp/f/<file>
cc_binary(
    name = "run_gate",
    srcs = ["src/run_gate.cc"],
    args = ["$(rootpath %s)" % CELL_SCENE],
    data = CELL_FILES,
    deps = [":trial_runner"],
)
# END gate

# BEGIN ompl
# OMPL (the Open Motion Planning Library), as a second search for the
# planner beside the RRT-Connect of src/rrt.h. Its build file is
# bazel/ompl.BUILD.bazel. :motion_planner depends on :ompl_search, so every
# target that plans compiles and links OMPL, and `bazel build //...` and
# `bazel test //...` build it.
alias(
    name = "ompl",
    actual = "@ompl//:ompl",
)

# OMPL posed the problem that PlanRrtConnect is posed: the same box, metric,
# edge check, seed and limits, over an abstract IsFree. Nothing here knows
# about the arm or MuJoCo. Include as "src/ompl_search.h".
cc_library(
    name = "ompl_search",
    srcs = ["src/ompl_search.cc"],
    hdrs = ["src/ompl_search.h"],
    deps = [
        ":rrt",
        "@eigen",
        "@ompl",
    ],
)

# The search against the planner's own: the metric and the edge check OMPL
# is given, seeds, the names it refuses; then the cell's carry planned with
# OMPL chosen, and one cycle run with it.
#   bazel test --config=opt //:ompl_search_test --test_output=all
cc_test(
    name = "ompl_search_test",
    size = "medium",
    srcs = ["tests/ompl_search_test.cc"],
    data = CELL_FILES,
    env = {"MODEL_PATH": "$(rootpath %s)" % CELL_SCENE},
    deps = [
        ":arm",
        ":cell",
        ":collision",
        ":conveyor",
        ":motion_planner",
        ":ompl_search",
        ":pick_place",
        ":portable_random",
        ":rrt",
        ":rrt_worlds",
        ":score",
        ":trial_runner",
        "@eigen",
        "@googletest//:gtest_main",
        "@mujoco",
    ],
)
# END ompl

# BEGIN bay
# One bay of a real single-axis tracker: a round torque tube section, its
# rails, its modules and every fastening point (docs/bay-hardware.md). The
# cell does not load these parts; they stand beside it until a layout takes
# them.
BAY_SCENE = "models/bay_scene.xml"

BAY_SCENE_FILES = MODELS_COMMON + [
    "models/bay.xml",
    BAY_SCENE,
]

# The document's figures as constants, and the pose of every rail, module
# and fastening point in the tube's frame. Header only.
# Include as "src/bay_hardware.h".
cc_library(
    name = "bay_hardware",
    hdrs = ["src/bay_hardware.h"],
    deps = ["@eigen"],
)

# Prints the bay's fastening points as CSV, one row each, or with --summary
# the bay's counts, size and mass.
#   bazel run //:print_bay
#   bazel run //:print_bay -- --summary
cc_binary(
    name = "print_bay",
    srcs = ["src/print_bay.cc"],
    deps = [
        ":bay_hardware",
        "@eigen",
    ],
)

# The model against the header: every site, the counts, the mass, the size,
# and that no two parts of the assembled bay overlap.
#   bazel test //:bay_hardware_test --test_output=all
cc_test(
    name = "bay_hardware_test",
    size = "small",
    srcs = ["tests/bay_hardware_test.cc"],
    data = BAY_SCENE_FILES,
    env = {"MODEL_PATH": "$(rootpath %s)" % BAY_SCENE},
    deps = [
        ":bay_hardware",
        ":mj_handles",
        "@eigen",
        "@googletest//:gtest_main",
        "@mujoco",
    ],
)

# Draws the finished bay in a window.
#   bazel run //:viewer_bay
cc_binary(
    name = "viewer_bay",
    srcs = ["src/viewer.cc"],
    args = ["$(rootpath %s)" % BAY_SCENE],
    data = BAY_SCENE_FILES,
    deps = [
        ":mj_handles",
        ":viewer_lib",
        "@mujoco",
    ],
)
# END bay

# BEGIN container
# The shipping container the cell is built into, in its working state, and
# a scene with a finished bay passing out through one of its open sides
# (docs/bay-hardware.md, "The container").
CONTAINER_SCENE = "models/container_scene.xml"

CONTAINER_SCENE_FILES = MODELS_COMMON + [
    "models/bay.xml",
    "models/container.xml",
    CONTAINER_SCENE,
]

# The container's figures as constants, its members and its two envelopes.
# Header only. Include as "src/container.h".
cc_library(
    name = "container",
    hdrs = ["src/container.h"],
    deps = ["@eigen"],
)

# The model against the header, the members inside the transport envelope,
# and the bay through the side opening.
#   bazel test //:container_test --test_output=all
cc_test(
    name = "container_test",
    size = "small",
    srcs = ["tests/container_test.cc"],
    data = CONTAINER_SCENE_FILES,
    env = {"MODEL_PATH": "$(rootpath %s)" % CONTAINER_SCENE},
    deps = [
        ":bay_hardware",
        ":container",
        ":mj_handles",
        "@eigen",
        "@googletest//:gtest_main",
        "@mujoco",
    ],
)

# Draws the container with the bay in a window.
#   bazel run //:viewer_container
cc_binary(
    name = "viewer_container",
    srcs = ["src/viewer.cc"],
    args = ["$(rootpath %s)" % CONTAINER_SCENE],
    data = CONTAINER_SCENE_FILES,
    deps = [
        ":mj_handles",
        ":viewer_lib",
        "@mujoco",
    ],
)
# END container
