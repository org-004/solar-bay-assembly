cc_library(
    name = "viewer_lib",
    srcs = ["src/viewer_lib.cc"],
    hdrs = ["src/viewer_lib.h"],
    deps = [
        ":mj_handles",
        "@glfw",
        "@mujoco",
    ],
)

# Draws the arm in a window.
#   bazel run //:viewer
cc_binary(
    name = "viewer",
    srcs = ["src/viewer.cc"],
    args = ["$(rootpath %s)" % UR10E],
    data = UR10E_FILES,
    deps = [
        ":mj_handles",
        ":viewer_lib",
        "@mujoco",
    ],
)

# BEGIN pick_place
# The blind pick and place: one module from the front of the stack onto the
# tube, as a state machine run one physics step at a time. Plans from the
# design poses only and never reads the truth. The carry is scripted, or
# planned by the motion planner (CarryMode::kPlanned); with the planned carry
# the check after pickup (check_after_pickup) measures the grip over the
# check camera and corrects the place for it.
# Include as "src/pick_place.h".
cc_library(
    name = "pick_place",
    srcs = ["src/pick_place.cc"],
    hdrs = ["src/pick_place.h"],
    deps = [
        ":arm",
        ":arm_follower",
        ":camera_model",
        ":cell",
        ":collision",
        ":conveyor",
        ":depth_camera",
        ":held_module_finder",
        ":ik",
        ":mj_handles",
        ":module_finder",
        ":motion_planner",
        ":pallet",
        ":path_timing",
        ":suction",
        "@eigen",
        "@mujoco",
    ],
)

# Watches a cycle from the truth: forbidden contacts, closest approaches,
# motor torques, joint ranges. For tests and the runner only.
# Include as "src/cycle_check.h".
cc_library(
    name = "cycle_check",
    srcs = ["src/cycle_check.cc"],
    hdrs = ["src/cycle_check.h"],
    deps = [
        ":arm",
        ":cell",
        ":pick_place",
        "@eigen",
        "@mujoco",
    ],
)

# Runs the pick and place headless (camera mode by default; --blind for the
# stage-3 baseline) and prints the score of every cycle as CSV, or with
# --pretty as an aligned table. Time it optimized:
#   bazel run --config=opt //:run_cell -- --pretty --trials 20
#   bazel run //:run_cell -- [--pretty] [--seed N] [--modules M] [--trials T]
#       [--nominal] [--blind] [--no-noise] [--calibration MM,DEG]
#       [--carry scripted|planned] [--check] [--check-calibration MM,DEG]
#       [--verbose]
cc_binary(
    name = "run_cell",
    srcs = ["src/run_cell.cc"],
    args = ["$(rootpath %s)" % CELL_SCENE],
    data = CELL_FILES,
    deps = [
        ":cell",
        ":cycle_check",
        ":held_module_finder",
        ":pick_place",
        ":score",
        ":suction",
        ":trial_runner",
        "@eigen",
        "@mujoco",
    ],
)

# The same pick and place in a window, with the pictures' outcomes and the
# score of each placement in the corner. Backspace runs the trial again.
#   bazel run --config=opt //:view_cell -- [--seed N] [--nominal]
#       [--modules M] [--blind] [--no-noise] [--calibration MM,DEG]
#       [--carry scripted|planned] [--check] [--check-calibration MM,DEG]
cc_binary(
    name = "view_cell",
    srcs = ["src/view_cell.cc"],
    args = ["$(rootpath %s)" % CELL_SCENE],
    data = CELL_FILES,
    deps = [
        ":cell",
        ":cycle_check",
        ":held_module_finder",
        ":module_finder",
        ":pick_place",
        ":score",
        ":suction",
        ":viewer_lib",
        "@eigen",
        "@mujoco",
    ],
)

# Each phase of the nominal cycle against its own postcondition, the whole
# cycle end to end, two modules in a row, the script's blindness, the place
# side from a constructed state, and a few randomized pallets. Simulates
# the nominal cycle once for the whole suite (about 70 s of the cell in
# all), which takes about 70 s in the default unoptimized build and 13 s
# optimized: medium, so a busy machine does not hit the limit.
#   bazel test //:pick_place_test
#   bazel test --config=opt //:pick_place_test --test_output=all
cc_test(
    name = "pick_place_test",
    size = "medium",
    srcs = ["tests/pick_place_test.cc"],
    data = CELL_FILES,
