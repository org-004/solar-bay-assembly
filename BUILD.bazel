        ":motion_planner",
        ":pallet",
        ":pick_place",
        ":score",
        ":suction",
        "@eigen",
        "@googletest//:gtest_main",
        "@mujoco",
    ],
) for name, gtest_filter in [
    ("check_cycle_test", "-CheckCycles.*"),
    ("check_cycle_batch_test", "CheckCycles.*"),
]]
# END check_cycle

