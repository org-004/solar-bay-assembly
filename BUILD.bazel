#   bazel run --config=opt //:print_rrt -- --sweep
#   bazel run --config=opt //:print_rrt -- --nn
cc_binary(
    name = "print_rrt",
    srcs = ["src/print_rrt.cc"],
    deps = [
        ":rrt",
        ":rrt_worlds",
        "@eigen",
    ],
)
# END rrt

# BEGIN path_timing
# Timing along a path: one motion through joint waypoints that rounds the
# corners instead of stopping at each, within velocity, acceleration and
# jerk limits and a bound on how far it strays from the waypoints' polyline.
# Include as "src/path_timing.h".
cc_library(
    name = "path_timing",
    srcs = ["src/path_timing.cc"],
    hdrs = ["src/path_timing.h"],
    deps = [
        ":joint_move",
        ":profile",
        "@eigen",
    ],
)

# The guarantees by dense sampling, on random polylines in six joints and on
# the awkward cases; prints the time against stopping at every waypoint and
# against lower bounds:
#   bazel test //:path_timing_test --test_output=all
cc_test(
    name = "path_timing_test",
    size = "small",
    srcs = ["tests/path_timing_test.cc"],
    deps = [
        ":joint_move",
        ":path_timing",
        ":profile",
        "@eigen",
        "@googletest//:gtest_main",
    ],
)

# The arm in models/arm_scene.xml following blended trajectories
# (ArmFollower::MoveAlong and Follow), with and without a module at the
