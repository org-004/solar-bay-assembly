# stands in for suction) at the top level.
SUCTION_SCENE = "models/suction_scene.xml"

SUCTION_SCENE_FILES = MODELS_COMMON + [
    SUCTION_SCENE,
    "models/suction.xml",
    "models/tool.xml",
]

# Gripping and releasing a module with the weld.
# Include as "src/suction.h".
cc_library(
    name = "suction",
    srcs = ["src/suction.cc"],
    hdrs = ["src/suction.h"],
    deps = [
        "@eigen",
        "@mujoco",
    ],
)

# Grips that must fail, grips that must pick the right module, a held module
# keeping its pose through a full carry, and clean releases. Simulates about
# three minutes on the test bench, in a few seconds.
