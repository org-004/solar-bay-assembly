# The arm following planned moves in models/arm_scene.xml, with and without
# a module's weight at the tool; and FindArm and TipPose from src/arm.h.
# About a minute of simulated motion, 5 s in the default build. Add
# --test_output=all to see the measured numbers.
#   bazel test //:arm_follower_test
cc_test(
    name = "arm_follower_test",
    size = "small",
    srcs = ["tests/arm_follower_test.cc"],
    data = ARM_SCENE_FILES,
    env = {"MODEL_PATH": "$(rootpath %s)" % ARM_SCENE},
    deps = [
        ":arm",
        ":arm_follower",
        ":joint_move",
