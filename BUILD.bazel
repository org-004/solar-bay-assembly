# END follower

# BEGIN ik
# Inverse kinematics: joint angles that put the tool tip at a wanted pose,
# by damped least squares on MuJoCo's Jacobians; also the tip pose that
# grips a face (GripPose) and straight lines of poses (StraightLine).
# Include as "src/ik.h".
cc_library(
    name = "ik",
    srcs = ["src/ik.cc"],
    hdrs = ["src/ik.h"],
    deps = [
        ":arm",
        "@eigen",
        "@mujoco",
    ],
)

# The arm with a free-floating box defined before it, so that the arm's
# joints are not the first in the model.
IK_SCENE = "models/ik_scene.xml"

# Round trips, far seeds, the cell's own poses, every module picked (grip,
# lift, 0.4 m pull-back) across the pallet's placement tolerance, unreachable
# and singular targets, straight-line paths, the pose helpers, and the box
# scene. The cell layout is at the top of the test file. Prints accuracy,
# success rate, the cell poses' angles and margins, and the time per solve;
# time it optimized:
#   bazel test --config=opt //:ik_test --test_output=all
cc_test(
    name = "ik_test",
    size = "small",
    srcs = ["tests/ik_test.cc"],
    data = ARM_SCENE_FILES + [IK_SCENE],
    env = {
        "MODEL_PATH": "$(rootpath %s)" % ARM_SCENE,
        "IK_SCENE_PATH": "$(rootpath %s)" % IK_SCENE,
    },
    deps = [
        ":arm",
        ":ik",
        ":mj_handles",
        "@eigen",
        "@googletest//:gtest_main",
        "@mujoco",
    ],
)
# END ik

# BEGIN cell
# The whole cell in one scene: arm and tool, pallet and stack, conveyor and
# tube, the suction weld, and the depth camera on its post.
CELL_SCENE = "models/cell.xml"

# Everything a target needs to load models/cell.xml.
CELL_FILES = MODELS_COMMON + [
    CELL_SCENE,
    "models/pallet.xml",
    "models/conveyor.xml",
    "models/suction.xml",
    ":arm_model",
]

# Loads the cell, finds its parts, and sets up a scene for each trial; holds
# the bookkeeping of which module is where. Include as "src/cell.h".
cc_library(
    name = "cell",
    srcs = ["src/cell.cc"],
    hdrs = ["src/cell.h"],
    deps = [
        ":arm",
        ":conveyor",
        ":mj_handles",
        ":pallet",
        ":suction",
        "@eigen",
        "@mujoco",
    ],
)

# Scores a run from the truth: placement errors on the tube, and how much
# the stack was disturbed. Include as "src/score.h".
cc_library(
    name = "score",
    srcs = ["src/score.cc"],
    hdrs = ["src/score.h"],
    deps = [
        ":cell",
        "@eigen",
    ],
)

# The parts together: names and counts, the stack still at rest with
# everything present, repeatable scenes, the camera's view, no stray
# contacts, the scorer, parking and swapping the tube. Simulates about 30 s
# of the whole cell, which takes about 20 s in the default unoptimized
# build: medium, like pallet_test, so a busy machine does not hit the 60 s
# limit of small.
#   bazel test //:cell_test
cc_test(
    name = "cell_test",
    size = "medium",
    srcs = ["tests/cell_test.cc"],
    # The arm's scene too, to check that loading a scene without a pallet
    # says so.
    data = CELL_FILES + [ARM_SCENE],
    env = {
        "MODEL_PATH": "$(rootpath %s)" % CELL_SCENE,
        "ARM_SCENE_PATH": "$(rootpath %s)" % ARM_SCENE,
    },
    deps = [
        ":arm",
        ":cell",
        ":conveyor",
        ":pallet",
        ":score",
        "@eigen",
        "@googletest//:gtest_main",
        "@mujoco",
    ],
)

# Loads and resets the cell, prints what touches what, where everything is,
# and how fast it simulates. Time it optimized:
#   bazel run --config=opt //:print_cell
#   bazel run --config=opt //:print_cell -- <seed> <seconds>
cc_binary(
    name = "print_cell",
    srcs = ["src/print_cell.cc"],
    args = ["$(rootpath %s)" % CELL_SCENE],
    data = CELL_FILES,
    deps = [
        ":arm",
        ":cell",
        ":pallet",
        ":score",
        "@eigen",
        "@mujoco",
    ],
)

# Draws the whole cell in a window, starting with the arm at arm_home.
# Nothing drives the arm or the conveyor here, so both hold still.
#   bazel run //:viewer_cell
cc_binary(
    name = "viewer_cell",
    srcs = ["src/viewer.cc"],
    args = ["$(rootpath %s)" % CELL_SCENE],
    data = CELL_FILES,
    deps = [
        ":mj_handles",
        ":viewer_lib",
        "@mujoco",
    ],
)
# END cell

# The window, mouse, keys and real-time loop shared by every viewer below and
# by programs that drive a simulation in a window. Include as
# "src/viewer_lib.h".
cc_library(
    name = "viewer_lib",
    srcs = ["src/viewer_lib.cc"],
    hdrs = ["src/viewer_lib.h"],
    deps = [
        ":mj_handles",
        "@glfw",
        "@mujoco",
    ],
)

# Draws the arm in a window.
#   bazel run //:viewer
cc_binary(
    name = "viewer",
    srcs = ["src/viewer.cc"],
    args = ["$(rootpath %s)" % UR10E],
    data = UR10E_FILES,
    deps = [
        ":mj_handles",
        ":viewer_lib",
        "@mujoco",
    ],
)

# BEGIN pick_place
# The blind pick and place: one module from the front of the stack onto the
# tube, as a state machine run one physics step at a time. Plans from the
# design poses only and never reads the truth.
# Include as "src/pick_place.h".
cc_library(
    name = "pick_place",
    srcs = ["src/pick_place.cc"],
    hdrs = ["src/pick_place.h"],
    deps = [
        ":arm",
        ":arm_follower",
        ":cell",
        ":conveyor",
        ":ik",
        ":mj_handles",
        ":pallet",
        ":suction",
        "@eigen",
        "@mujoco",
    ],
)

# Watches a cycle from the truth: forbidden contacts, closest approaches,
# motor torques, joint ranges. For tests and the runner only.
# Include as "src/cycle_check.h".
cc_library(
    name = "cycle_check",
    srcs = ["src/cycle_check.cc"],
    hdrs = ["src/cycle_check.h"],
    deps = [
        ":arm",
        ":cell",
        ":pick_place",
        "@eigen",
        "@mujoco",
    ],
)

# Runs the pick and place headless and prints the score of every cycle as
# CSV, or with --pretty as an aligned table. Time it optimized:
#   bazel run --config=opt //:run_cell -- --pretty --trials 10
#   bazel run //:run_cell -- [--pretty] [--seed N] [--modules M] [--trials T]
#                            [--nominal] [--verbose]
cc_binary(
    name = "run_cell",
    srcs = ["src/run_cell.cc"],
    args = ["$(rootpath %s)" % CELL_SCENE],
    data = CELL_FILES,
    deps = [
        ":cell",
        ":cycle_check",
        ":pick_place",
        ":score",
        "@mujoco",
    ],
)

# The same pick and place in a window, with the score of each placement in
# the corner. Backspace runs the trial again.
#   bazel run //:view_cell -- [--seed N] [--nominal] [--modules M]
cc_binary(
    name = "view_cell",
    srcs = ["src/view_cell.cc"],
    args = ["$(rootpath %s)" % CELL_SCENE],
    data = CELL_FILES,
    deps = [
        ":cell",
        ":pick_place",
        ":score",
        ":viewer_lib",
        "@mujoco",
    ],
)

# Each phase of the nominal cycle against its own postcondition, the whole
# cycle end to end, two modules in a row, the script's blindness, the place
# side from a constructed state, and a few randomized pallets. Simulates
# the nominal cycle once for the whole suite (about 70 s of the cell in
# all), which takes about 70 s in the default unoptimized build and 13 s
# optimized: medium, so a busy machine does not hit the limit.
#   bazel test //:pick_place_test
#   bazel test --config=opt //:pick_place_test --test_output=all
cc_test(
    name = "pick_place_test",
    size = "medium",
    srcs = ["tests/pick_place_test.cc"],
    data = CELL_FILES,
    env = {"MODEL_PATH": "$(rootpath %s)" % CELL_SCENE},
    deps = [
        ":arm",
        ":cell",
        ":conveyor",
        ":cycle_check",
        ":pallet",
        ":pick_place",
        ":score",
        ":suction",
        "@eigen",
        "@googletest//:gtest_main",
        "@mujoco",
    ],
)
# END pick_place
