"""Fetches files of one KUKA robot from kroshu/kuka_robot_descriptions.

The sibling of menagerie.bzl: the same idea for a different source. The
repository holds every KUKA robot ROS supports and is far larger than one
robot's meshes, so only the listed files are downloaded, each checked against
a SHA-256 hash, at one pinned commit.
"""

_BUILD = """\
# Generated by kuka_description in //bazel:kuka.bzl.
package(default_visibility = ["//visibility:public"])

exports_files(glob(["**"]))

filegroup(
    name = "{name}",
    srcs = glob(["**"], exclude = ["BUILD.bazel", "REPO.bazel"]),
)
"""

def _kuka_description_impl(ctx):
    base = ctx.attr.base_url.format(commit = ctx.attr.commit)
    prefix = ctx.attr.strip_prefix
    if prefix and not prefix.endswith("/"):
        prefix += "/"
    for path, sha256 in ctx.attr.files.items():
        # Files under strip_prefix land at their path below it; anything else
        # (such as the LICENSE at the top of the repository) keeps its path.
        output = path[len(prefix):] if prefix and path.startswith(prefix) else path
        ctx.download(
            url = base + "/" + path,
            output = output,
            sha256 = sha256,
        )
    ctx.file("BUILD.bazel", _BUILD.format(name = ctx.attr.target_name))

kuka_description = repository_rule(
    implementation = _kuka_description_impl,
    doc = "Downloads the listed files of kuka_robot_descriptions at one commit.",
    attrs = {
        "commit": attr.string(
            mandatory = True,
            doc = "kuka_robot_descriptions commit the files are taken from.",
        ),
        "files": attr.string_dict(
            mandatory = True,
            doc = "Path from the top of that repository -> SHA-256 of the file.",
        ),
        "strip_prefix": attr.string(
            default = "",
            doc = "Leading directory removed from the paths of files under it.",
        ),
        "target_name": attr.string(
            mandatory = True,
            doc = "Name of the filegroup holding every downloaded file.",
        ),
        "base_url": attr.string(
            default = "https://raw.githubusercontent.com/kroshu/kuka_robot_descriptions/{commit}",
            doc = "Where the files are served from. Point it at another host to self-host.",
        ),
    },
)
