"""Fetches one robot model from MuJoCo Menagerie as an external repository.

Menagerie as a whole is several hundred megabytes, so only the files of the
one model are downloaded, each checked against a SHA-256 hash.
"""

_BUILD = """\
# Generated by menagerie_model in //bazel:menagerie.bzl.
package(default_visibility = ["//visibility:public"])

exports_files(glob(["**"]))

filegroup(
    name = "{name}",
    srcs = glob(["**"], exclude = ["BUILD.bazel", "REPO.bazel"]),
)
"""

def _menagerie_model_impl(ctx):
    base = ctx.attr.base_url.format(commit = ctx.attr.commit, model = ctx.attr.model)
    for path, sha256 in ctx.attr.files.items():
        ctx.download(
            url = base + "/" + path,
            output = path,
            sha256 = sha256,
        )
    ctx.file("BUILD.bazel", _BUILD.format(name = ctx.attr.target_name))

menagerie_model = repository_rule(
    implementation = _menagerie_model_impl,
    doc = "Downloads the listed files of one Menagerie model directory.",
    attrs = {
        "model": attr.string(
            mandatory = True,
            doc = "Directory name in Menagerie, such as universal_robots_ur10e.",
        ),
        "commit": attr.string(
            mandatory = True,
            doc = "Menagerie commit the files are taken from.",
        ),
        "files": attr.string_dict(
            mandatory = True,
            doc = "Path within the model directory -> SHA-256 of the file.",
        ),
        "target_name": attr.string(
            mandatory = True,
            doc = "Name of the filegroup holding every downloaded file.",
        ),
        "base_url": attr.string(
            default = "https://raw.githubusercontent.com/google-deepmind/mujoco_menagerie/{commit}/{model}",
            doc = "Where the files are served from. Point it at another host to self-host.",
        ),
    },
)
