# C++20 for this project's code and for everything it builds from source.
build --cxxopt=-std=c++20
build --host_cxxopt=-std=c++20

# Print a failing test's output in the terminal instead of only a log path.
test --test_output=errors

# Show compiler output only for this repository's own targets. Dependencies are
# compiled from source and their warnings would otherwise fill the terminal.
# Errors are always shown.
build --output_filter=^//

# On 64-bit ARM, GCC prints a note wherever a small fixed-size Eigen vector is
# passed or returned by value, because the calling convention for such types
# changed in GCC 10.1. It matters only when linking against code built by an
# older GCC, and everything here is built from source by one compiler. The
# note is turned off for this repository's own files only; changing the
# options of the dependencies would compile MuJoCo again.
build --per_file_copt=^(src|tests)/.*\.cc$@-Wno-psabi

# An optimized build, for measuring speed:
#   bazel run --config=opt //:print_pallet
# With optimization on, GCC warns that a variable in one of MuJoCo's files may
# be used before it is set, and MuJoCo's build turns warnings into errors, so
# plain `-c opt` fails. This config turns that one error back into a warning.
build:opt -c opt
build:opt --per_file_copt=^external/mujoco.*@-Wno-error=maybe-uninitialized

# For an agent working beside others, each in its own worktree:
#   bazel test --config=opt --config=agent //:cell_test
# One full run of the suite already fills this machine's cores and, unlimited,
# three at once ran it out of memory (measured 2026-11-22). The limit keeps
# each worktree to three cores. The gate (about 4 minutes on 4 cores) is left
# out: the lead runs it once, alone, before a commit, and CI runs it.
build:agent --local_resources=cpu=3
build:agent --jobs=3
test:agent --test_tag_filters=-gate

# Compiler warnings for correctness, for this repository's own files only
# (docs/adr/0014-compiler-warnings.md gives the reason for each flag and for
# each flag left out). Each of these finds nothing in src/ and tests/ and in
# the headers they include, under GCC 14.2 and GCC 13.3, and is decided by the
# compiler's front end, so the answer does not move with the optimizer: it is
# an error in every build. The options of the dependencies are untouched.
build --per_file_copt=^(src|tests)/.*\.cc$@-Werror=return-type,-Werror=switch,-Werror=sign-compare,-Werror=reorder,-Werror=delete-non-virtual-dtor,-Werror=non-virtual-dtor,-Werror=suggest-override,-Werror=unused-value,-Werror=unused-result,-Werror=address,-Werror=bool-compare,-Werror=tautological-compare,-Werror=sizeof-pointer-memaccess,-Werror=memset-transposed-args,-Werror=sizeof-array-div,-Werror=logical-not-parentheses,-Werror=int-in-bool-context,-Werror=sequence-point,-Werror=misleading-indentation,-Werror=implicit-fallthrough,-Werror=empty-body,-Werror=class-memaccess,-Werror=format,-Werror=format-security,-Werror=vla,-Werror=logical-op,-Werror=duplicated-cond,-Werror=cast-qual,-Werror=undef

# The warnings that still find something in this repository's files, or that
# cannot be errors because the optimizer or the platform decides them or
# because they fire inside Eigen's headers. They are warnings, and only here:
#   bazel build --config=opt --config=strict //...
# tools/architecture/warnings.sh counts their places; the counts are lines of
# docs/architecture/baseline.txt and may not grow. A flag whose count reaches
# zero moves to the list above in the same commit, if the front end decides it.
build:strict --per_file_copt=^(src|tests)/.*\.cc$@-Wshadow,-Wconversion,-Wmissing-field-initializers,-Wparentheses,-Wcomment,-Wnull-dereference,-Wold-style-cast,-Woverloaded-virtual,-Wduplicated-branches,-Wcast-align,-Wtype-limits,-Wdangling-reference

# Run-time checking, for this repository's own files only (the dependencies
# are not instrumented, so a fault inside MuJoCo is seen only where it touches
# this code):
#   bazel test --config=opt --config=agent --config=asan //...
#   bazel test --config=opt --config=agent --config=ubsan //...
# A finding stops the test and is printed with its stack.
build:asan --per_file_copt=^(src|tests)/.*\.cc$@-fsanitize=address,-fno-omit-frame-pointer
build:asan --linkopt=-fsanitize=address
test:asan --test_env=ASAN_OPTIONS=detect_leaks=0:abort_on_error=1
build:ubsan --per_file_copt=^(src|tests)/.*\.cc$@-fsanitize=undefined,-fno-omit-frame-pointer
build:ubsan --linkopt=-fsanitize=undefined
test:ubsan --test_env=UBSAN_OPTIONS=print_stacktrace=1:halt_on_error=1
